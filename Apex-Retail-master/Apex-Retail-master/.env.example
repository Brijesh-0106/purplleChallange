# ─── Apex Retail · Environment Variables (template) ────────────────
# Copy to `.env` and edit as needed. Never commit `.env`.
#
# DEFAULTS (this file): SQLite — zero infra needed for local dev.
# For the docker-compose path (acceptance gate / reviewer), uncomment the
# Postgres block at the bottom; docker-compose.yml overrides DB_HOST=db.

# --- Application ---
APP_NAME=apex-retail-store-intelligence
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                      # true → JSON logs (prod); false → human-readable (dev)

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (SQLite — local dev default) ---
DB_DRIVER=sqlite
DB_NAME=./data/apex.db              # SQLite path (forward slashes ok on Windows)
# Unused for SQLite, kept so Settings stays consistent:
DB_HOST=
DB_PORT=0
DB_USER=
DB_PASSWORD=

# --- Health / staleness ---
STALE_FEED_THRESHOLD_MINUTES=10

# --- Future batches (placeholders) ---
EVENT_INGEST_BATCH_MAX=500
SESSION_GAP_MINUTES=10
POS_CORRELATION_WINDOW_MINUTES=5

# ── Postgres (docker-compose path; uncomment to switch) ───────────
# DB_DRIVER=postgresql+psycopg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=apex_retail
# DB_USER=apex
# DB_PASSWORD=apex_dev_password
